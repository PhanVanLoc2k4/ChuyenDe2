<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Quản lý hệ thống CLB & Sự kiện</title>
    <link rel="stylesheet" href="/CSS/bien.css?v=3">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap"
        rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/CSS/admin.css?v=2">
</head>

<body>
    <%- include('partials/Header') %>
        <div class="admin-app">
            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Logo removed for platform consistency, Header already has it -->

                <div class="admin-info">
                    <div class="admin-avatar">
                        <i class="fas fa-crown"></i>
                    </div>
                    <div class="admin-details">
                        <h4>Nhà trường (University)</h4>
                        <p>Quản trị viên cấp cao</p>
                    </div>
                </div>

                <div class="sidebar-nav">
                    <div class="menu-category">Tổng quan</div>
                    <a href="#" class="nav-item active" onclick="showPage('dashboard')">
                        <i class="fas fa-th-large"></i> <span>Tổng quan</span>
                    </a>
                    <a href="#" class="nav-item" onclick="showPage('users')">
                        <i class="fas fa-users"></i> <span>Người dùng</span>
                    </a>
                    <a href="#" class="nav-item" onclick="showPage('clubs')">
                        <i class="fas fa-university"></i> <span>Câu lạc bộ</span>
                    </a>
                    <a href="#" class="nav-item" onclick="showPage('events')">
                        <i class="fas fa-calendar-alt"></i> <span>Sự kiện</span>
                    </a>
                    <a href="#" class="nav-item" onclick="showPage('settings')">
                        <i class="fas fa-cog"></i> <span>Cài đặt</span>
                    </a>
                    <a href="#" class="nav-item" onclick="showPage('points')">
                        <i class="fas fa-star"></i> <span>Điểm rèn luyện</span>
                    </a>
                    <a href="#" class="nav-item" onclick="showPage('support')">
                        <i class="fas fa-headset"></i> <span>Hỗ trợ & Kết nối</span>
                    </a>
                </div>
            </div>

            <!-- Support Reply Modal -->
            <div class="modal" id="supportReplyModal">
                <div class="modal-content" style="max-width: 600px;">
                    <div class="modal-header">
                        <h2>Phản hồi Yêu cầu</h2>
                        <button class="close-btn" onclick="closeModal('supportReplyModal')"><i
                                class="fas fa-times"></i></button>
                    </div>
                    <div id="supportDetailView"
                        style="margin-bottom: 25px; padding: 20px; background: #f8fafc; border-radius: 16px; border: 1px dashed #cbd5e1;">
                        <p style="font-size: 13px; color: #64748b; margin-bottom: 5px;" id="replySenderInfo">Người gửi:
                            SV123 - Nguyễn Văn A</p>
                        <h4 id="replySubject" style="margin-bottom: 10px; color: #1e293b;">Tiêu đề yêu cầu</h4>
                        <p id="replyMessage" style="font-size: 14px; color: #475569; line-height: 1.6;">Nội dung yêu cầu
                            chi tiết...</p>
                    </div>
                    <form id="adminReplyForm">
                        <input type="hidden" id="replyRequestId">
                        <div class="form-group">
                            <label>Nội dung phản hồi</label>
                            <textarea id="adminReplyContent" class="form-control-mod" style="min-height: 120px;"
                                placeholder="Nhập nội dung phản hồi cho sinh viên..." required></textarea>
                        </div>
                        <div class="form-group">
                            <label>Trạng thái mới</label>
                            <select id="adminReplyStatus" class="form-control-mod">
                                <option value="resolved">Đã phản hồi (Hoàn tất)</option>
                                <option value="processing">Đang xử lý</option>
                                <option value="closed">Đóng yêu cầu (Không giải quyết)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-submit-mod">
                            <i class="fas fa-paper-plane"></i> Gửi phản hồi ngay
                        </button>
                    </form>
                </div>
            </div>
            <div class="main-content" id="mainContent">
                <!-- Dashboard Page -->
                <div id="dashboard-page">
                    <!-- Header -->
                    <div class="header">
                        <div>
                            <h1>Dashboard tổng quan</h1>
                            <p id="dashboardDateText">Thống kê hệ thống toàn thời gian</p>
                        </div>
                        <div class="header-actions">
                            <div class="date-picker-container" style="position: relative;">
                                <div class="date-picker" onclick="toggleDateDropdown()">
                                    <i class="fas fa-calendar" style="color: #c53030;"></i>
                                    <span id="currentDateDisplay">Tất cả thời gian</span>
                                    <i class="fas fa-chevron-down" style="font-size: 12px;"></i>
                                </div>
                                <!-- Simple Custom Date Dropdown -->
                                <div id="dateDropdown"
                                    style="display: none; position: absolute; top: 100%; right: 0; background: white; border-radius: 12px; box-shadow: var(--shadow-lg); padding: 15px; z-index: 1001; min-width: 200px; margin-top: 10px; border: 1px solid var(--border-color);">
                                    <div style="margin-bottom: 10px;">
                                        <label
                                            style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 5px;">Chọn
                                            năm</label>
                                        <select id="selectYear"
                                            style="width: 100%; padding: 8px; border-radius: 8px; border: 1px solid #e2e8f0;"
                                            onchange="handleDateFilterChange()">
                                            <option value="all">Tất cả các năm</option>
                                            <option value="2026">2026</option>
                                            <option value="2025">2025</option>
                                            <option value="2024">2024</option>
                                        </select>
                                    </div>
                                    <div id="monthFilterContainer" style="display: none;">
                                        <label
                                            style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 5px;">Chọn
                                            tháng</label>
                                        <select id="selectMonth"
                                            style="width: 100%; padding: 8px; border-radius: 8px; border: 1px solid #e2e8f0;"
                                            onchange="handleDateFilterChange()">
                                            <option value="all">Tất cả các tháng</option>
                                            <option value="1">Tháng 1</option>
                                            <option value="2">Tháng 2</option>
                                            <option value="3">Tháng 3</option>
                                            <option value="4">Tháng 4</option>
                                            <option value="5">Tháng 5</option>
                                            <option value="6">Tháng 6</option>
                                            <option value="7">Tháng 7</option>
                                            <option value="8">Tháng 8</option>
                                            <option value="9">Tháng 9</option>
                                            <option value="10">Tháng 10</option>
                                            <option value="11">Tháng 11</option>
                                            <option value="12">Tháng 12</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stats Cards -->
                    <div class="stats-grid">
                        <div class="stat-card" onclick="showPage('users')">
                            <div class="stat-icon"><i class="fas fa-users"></i></div>
                            <div class="stat-number" id="statTotalUsers">0</div>
                            <div class="stat-label">Tổng người dùng</div>
                        </div>
                        <div class="stat-card" onclick="showPage('clubs')">
                            <div class="stat-icon"><i class="fas fa-university"></i></div>
                            <div class="stat-number" id="statTotalClubs">0</div>
                            <div class="stat-label">CLB đang hoạt động</div>
                        </div>
                        <div class="stat-card" onclick="showPage('events')">
                            <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                            <div class="stat-number" id="statTotalEvents">0</div>
                            <div class="stat-label">Sự kiện đã tổ chức</div>
                        </div>
                    </div>

                    <!-- Charts Row -->
                    <div class="charts-row">
                        <div class="chart-card">
                            <div class="chart-header">
                                <h3>Thống kê theo tháng</h3>
                                <div class="chart-period">
                                    <button class="period-btn active" onclick="updateMonthlyChart('6months')">6
                                        tháng</button>
                                    <button class="period-btn" onclick="updateMonthlyChart('12months')">12
                                        tháng</button>
                                    <button class="period-btn" onclick="updateMonthlyChart('24months')">24
                                        tháng</button>
                                </div>
                            </div>
                            <div class="chart-container">
                                <canvas id="monthlyChart"></canvas>
                            </div>
                        </div>

                        <div class="chart-card">
                            <div class="chart-header">
                                <h3>Thống kê theo năm</h3>
                                <div class="chart-period">
                                    <button class="period-btn active" onclick="updateYearlyChart('2026')">2026</button>
                                    <button class="period-btn" onclick="updateYearlyChart('2025')">2025</button>
                                    <button class="period-btn" onclick="updateYearlyChart('2024')">2024</button>
                                </div>
                            </div>
                            <div class="chart-container">
                                <canvas id="yearlyChart"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Tables -->
                    <div class="tables-section">
                        <!-- Top CLB -->
                        <div class="table-card">
                            <div class="table-header">
                                <h3>CLB hoạt động nhiều nhất</h3>
                                <span class="view-link" onclick="showPage('clubs')">Xem tất cả →</span>
                            </div>
                            <table>
                                <thead>
                                    <tr>
                                        <th>CLB</th>
                                        <th>Thành viên</th>
                                        <th>Sự kiện</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="topClubsTableBody">
                                    <!-- Dữ liệu sẽ được load từ API -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Summary Stats -->
                    <div class="summary-stats">
                        <div class="summary-card">
                            <div class="summary-title">Người dùng theo vai trò</div>
                            <div class="summary-number" id="summaryTotalUsers">0</div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: 70%"></div>
                            </div>
                            <div style="display: flex; justify-content: space-between; font-size: 13px;">
                                <span>Sinh viên: 2,200</span>
                                <span>Ban tổ chức: 244</span>
                                <span>Nhà trường: 12</span>
                            </div>
                        </div>

                        <div class="summary-card" onclick="showPage('clubs')" style="cursor: pointer;">
                            <div class="summary-title">CLB theo lĩnh vực</div>
                            <div class="summary-number">48</div>
                            <div style="margin-top: 16px;">
                                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                    <span>Công nghệ</span>
                                    <span>12 CLB</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                    <span>Nghệ thuật</span>
                                    <span>10 CLB</span>
                                </div>
                                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                    <span>Thể thao</span>
                                    <span>8 CLB</span>
                                </div>
                            </div>
                        </div>

                        <div class="summary-card">
                            <div class="summary-title">Tổng quan năm 2026</div>
                            <div class="summary-number">156</div>
                            <div style="color: #64748b; font-size: 14px;">Sự kiện đã tổ chức</div>
                            <div style="margin-top: 16px;">
                                <div style="display: flex; justify-content: space-between;">
                                    <span>Quý 1:</span>
                                    <span>45 sự kiện</span>
                                </div>
                                <div style="display: flex; justify-content: space-between;">
                                    <span>Quý 2 (dự kiến):</span>
                                    <span>60 sự kiện</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Page: Hỗ trợ & Kết nối -->
                <div id="support-page" style="display: none;">
                    <div class="header">
                        <div>
                            <h1>Quản lý Hỗ trợ & Kết nối</h1>
                            <p>Xử lý yêu cầu và phản hồi từ sinh viên & CLB</p>
                        </div>
                        <div class="header-actions">
                            <button class="nut-bam-premium nut-chinh" onclick="loadSupportRequests()"><i
                                    class="fas fa-sync"></i> Làm mới</button>
                        </div>
                    </div>

                    <div class="table-card" style="margin-top: 30px;">
                        <div class="table-header">
                            <h3>Yêu cầu đang chờ xử lý</h3>
                        </div>
                        <table>
                            <thead>
                                <tr>
                                    <th>Người gửi</th>
                                    <th>Phân loại</th>
                                    <th>Tiêu đề</th>
                                    <th>Ngày gửi</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="adminSupportTableBody">
                                <!-- Data populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Page: Điểm rèn luyện -->
                <div id="points-page" style="display: none;">
                    <div class="header">
                        <div>
                            <h1>Quản lý Điểm rèn luyện</h1>
                            <p>Danh sách lịch sử cộng điểm rèn luyện toàn hệ thống</p>
                        </div>
                        <div class="header-actions">
                            <button class="date-picker" onclick="showAwardPointsModal()">
                                <i class="fas fa-plus"></i>
                                <span>Cộng điểm thủ công</span>
                            </button>
                        </div>
                    </div>

                    <div class="table-card" style="margin-top: 30px;">
                        <div class="table-header">
                            <h3>Lịch sử cộng điểm gần đây</h3>
                            <button class="action-btn" onclick="loadPointsData()" title="Làm mới"><i
                                    class="fas fa-sync"></i></button>
                        </div>
                        <table>
                            <thead>
                                <tr>
                                    <th>Sinh viên</th>
                                    <th>Số điểm</th>
                                    <th>Lý do</th>
                                    <th>Người cộng</th>
                                    <th>Ngày cộng</th>
                                </tr>
                            </thead>
                            <tbody id="pointsTableBody">
                                <!-- Data populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Users Management Page (ẩn mặc định) -->
                <div id="users-page" style="display: none;">
                    <div class="header">
                        <div>
                            <h1>Quản lý người dùng</h1>
                            <p>Danh sách tất cả người dùng trong hệ thống</p>
                        </div>
                        <div class="header-actions">
                            <!-- Nút Thêm người dùng đã được gỡ bỏ theo yêu cầu -->
                        </div>
                    </div>

                    <div class="search-filter">
                        <div class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" placeholder="Tìm kiếm người dùng..." id="searchUser">
                        </div>
                        <select class="filter-select" id="filterRole" onchange="loadUsersTable()">
                            <option value="all">Tất cả vai trò</option>
                            <option value="user">User</option>
                            <option value="leader">Leader</option>
                            <option value="university">Nhà trường</option>
                        </select>
                    </div>

                    <div class="table-card">
                        <table>
                            <thead>
                                <tr>
                                    <th>Người dùng</th>
                                    <th>Email</th>
                                    <th>Vai trò</th>
                                    <th>Ngày tham gia</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="userTableBody">
                                <!-- Dữ liệu sẽ được load từ API -->
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination">
                        <button class="page-btn"><i class="fas fa-chevron-left"></i></button>
                        <button class="page-btn active">1</button>
                        <button class="page-btn">2</button>
                        <button class="page-btn">3</button>
                        <button class="page-btn">4</button>
                        <button class="page-btn">5</button>
                        <button class="page-btn"><i class="fas fa-chevron-right"></i></button>
                    </div>
                </div>

                <!-- Clubs Management Page -->
                <div id="clubs-page" style="display: none;">
                    <div class="header">
                        <div>
                            <h1>Quản lý câu lạc bộ</h1>
                            <p>Danh sách các CLB trong hệ thống</p>
                        </div>
                        <div class="header-actions">
                            <button class="date-picker" onclick="showAddClubModal()">
                                <i class="fas fa-plus"></i>
                                <span>Thêm CLB</span>
                            </button>
                        </div>
                    </div>

                    <div class="search-filter">
                        <div class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" placeholder="Tìm kiếm CLB...">
                        </div>
                        <select class="filter-select">
                            <option>Tất cả lĩnh vực</option>
                            <option>Công nghệ</option>
                            <option>Nghệ thuật</option>
                            <option>Thể thao</option>
                            <option>Tình nguyện</option>
                        </select>
                    </div>

                    <div class="table-card">
                        <table>
                            <thead>
                                <tr>
                                    <th>CLB</th>
                                    <th>Lĩnh vực</th>
                                    <th>Chủ nhiệm</th>
                                    <th>Thành viên</th>
                                    <th>Sự kiện</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="clubTableBody">
                                <!-- Dữ liệu sẽ được load từ API -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Events Management Page -->
                <div id="events-page" style="display: none;">
                    <div class="header">
                        <div>
                            <h1>Quản lý sự kiện</h1>
                            <p>Danh sách các sự kiện trong hệ thống</p>
                        </div>
                        <div class="header-actions">
                            <button class="date-picker" onclick="showAddEventModal()">
                                <i class="fas fa-plus"></i>
                                <span>Thêm sự kiện</span>
                            </button>
                        </div>
                    </div>

                    <div class="table-card">
                        <table>
                            <thead>
                                <tr>
                                    <th>Sự kiện</th>
                                    <th>CLB tổ chức</th>
                                    <th>Ngày diễn ra</th>
                                    <th>Địa điểm</th>
                                    <th>Đăng ký</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="eventTableBody">
                                <!-- Dữ liệu sẽ được load từ API -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Monthly Report Page -->
                <div id="monthly-report-page" style="display: none;">
                    <div class="header">
                        <div>
                            <h1>Báo cáo theo tháng</h1>
                            <p>Thống kê chi tiết từng tháng</p>
                        </div>
                        <div class="header-actions">
                            <button class="date-picker" onclick="exportReport()">
                                <i class="fas fa-download"></i>
                                <span>Xuất báo cáo</span>
                            </button>
                        </div>
                    </div>

                    <div class="chart-card" style="height: 400px;">
                        <canvas id="monthlyDetailChart"></canvas>
                    </div>

                    <div class="stats-grid" style="margin-top: 24px;">
                        <div class="stat-card">
                            <div class="stat-number">156</div>
                            <div class="stat-label">Tổng sự kiện</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number">48</div>
                            <div class="stat-label">CLB hoạt động</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number">2,456</div>
                            <div class="stat-label">Lượt tham gia</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number">89%</div>
                            <div class="stat-label">Tỷ lệ tham dự</div>
                        </div>
                    </div>
                </div>

                <!-- Yearly Report Page -->
                <div id="yearly-report-page" style="display: none;">
                    <div class="header">
                        <div>
                            <h1>Báo cáo theo năm</h1>
                            <p>Thống kê chi tiết theo năm</p>
                        </div>
                    </div>

                    <div class="chart-card" style="height: 400px;">
                        <canvas id="yearlyDetailChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Add User Modal -->
        <div class="modal" id="addUserModal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Thêm người dùng mới</h2>
                    <button class="close-btn" onclick="closeModal('addUserModal')"><i class="fas fa-times"></i></button>
                </div>
                <div class="modal-form">
                    <div class="form-group">
                        <label>Họ và tên</label>
                        <input type="text" placeholder="Nhập họ tên...">
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" placeholder="Nhập email...">
                    </div>
                    <div class="form-group">
                        <label>Mã số sinh viên</label>
                        <input type="text" placeholder="Nhập MSSV...">
                    </div>
                    <div class="form-group">
                        <label>Vai trò</label>
                        <select>
                            <option>Sinh viên</option>
                            <option>Ban tổ chức</option>
                            <option>Admin</option>
                        </select>
                    </div>
                    <div class="modal-actions">
                        <button class="btn-save" onclick="saveUser()">Thêm người dùng</button>
                        <button class="btn-cancel" onclick="closeModal('addUserModal')">Hủy</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Add Club Modal -->
        <div class="modal" id="addClubModal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Thêm CLB mới</h2>
                    <button class="close-btn" onclick="closeModal('addClubModal')"><i class="fas fa-times"></i></button>
                </div>
                <div class="modal-form">
                    <div class="form-group">
                        <label>Tên CLB</label>
                        <input type="text" placeholder="Nhập tên CLB...">
                    </div>
                    <div class="form-group">
                        <label>Lĩnh vực</label>
                        <select>
                            <option>Công nghệ</option>
                            <option>Nghệ thuật</option>
                            <option>Thể thao</option>
                            <option>Tình nguyện</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Chủ nhiệm</label>
                        <input type="text" placeholder="Tên chủ nhiệm...">
                    </div>
                    <div class="form-group">
                        <label>Mô tả</label>
                        <textarea placeholder="Mô tả về CLB..."></textarea>
                    </div>
                    <div class="modal-actions">
                        <button class="btn-save" onclick="saveClub()">Thêm CLB</button>
                        <button class="btn-cancel" onclick="closeModal('addClubModal')">Hủy</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- User Detail Modal -->
        <div class="modal" id="userDetailModal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Chi tiết người dùng</h2>
                    <button class="close-btn" onclick="closeModal('userDetailModal')"><i
                            class="fas fa-times"></i></button>
                </div>
                <div class="user-profile-header">
                    <div class="user-avatar-large">NA</div>
                    <div>
                        <h3 id="detailUserName">Nguyễn Văn An</h3>
                        <p>MSSV: 20210001</p>
                        <p>Email: an.nguyen@student.edu</p>
                    </div>
                </div>
                <div style="margin-top: 20px;">
                    <h4>Hoạt động gần đây</h4>
                    <table class="table">
                        <tr>
                            <td>Tham gia CLB Tin học</td>
                            <td>01/03/2026</td>
                        </tr>
                        <tr>
                            <td>Đăng ký Workshop React</td>
                            <td>15/03/2026</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Club Detail Modal -->
        <div class="modal" id="clubDetailModal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="detailClubName">Chi tiết Câu lạc bộ</h2>
                    <button class="close-btn" onclick="closeModal('clubDetailModal')"><i
                            class="fas fa-times"></i></button>
                </div>
                <div class="club-profile-header"
                    style="display: flex; gap: 20px; align-items: center; padding: 20px; background: #f8fafc; border-radius: 12px; margin-bottom: 20px;">
                    <img id="detailClubLogo" src="/placeholder-club.png"
                        style="width: 100px; height: 100px; border-radius: 12px; object-fit: cover; border: 3px solid white; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);">
                    <div>
                        <h3 id="detailClubTitle" style="font-size: 24px; color: #1e293b; margin-bottom: 5px;">CLB Tên
                        </h3>
                        <p id="detailClubCategory" style="color: #64748b; font-weight: 500;"><i class="fas fa-tag"></i>
                            <span>Chuyên mục</span>
                        </p>
                        <p id="detailClubCreator" style="color: #64748b; font-size: 14px;"><i
                                class="fas fa-user-edit"></i> Người tạo: <span>Tên người tạo</span></p>
                    </div>
                </div>
                <div class="grid" style="grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 25px;">
                    <div class="card"
                        style="padding: 15px; text-align: center; background: #fff1f2; border: 1px solid #fecdd3;">
                        <div style="font-size: 20px; font-weight: 700; color: #e11d48;" id="detailMemberCount">0</div>
                        <div style="font-size: 12px; color: #9f1239;">Thành viên</div>
                    </div>
                    <div class="card"
                        style="padding: 15px; text-align: center; background: #eff6ff; border: 1px solid #bfdbfe;">
                        <div style="font-size: 20px; font-weight: 700; color: #2563eb;" id="detailEventCount">0</div>
                        <div style="font-size: 12px; color: #1e40af;">Sự kiện</div>
                    </div>
                    <div class="card"
                        style="padding: 15px; text-align: center; background: #f0fdf4; border: 1px solid #bbf7d0;">
                        <div style="font-size: 20px; font-weight: 700; color: #16a34a;" id="detailPostCount">0</div>
                        <div style="font-size: 12px; color: #166534;">Bài viết</div>
                    </div>
                </div>

                <div style="margin-top: 20px;">
                    <h4 style="margin-bottom: 10px; border-bottom: 2px solid #ef4444; display: inline-block;">Danh sách
                        thành viên</h4>
                    <div style="max-height: 250px; overflow-y: auto;">
                        <table class="table" id="clubMembersTable">
                            <thead>
                                <tr>
                                    <th>Thành viên</th>
                                    <th>Vai trò</th>
                                    <th>Ngày tham gia</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Data populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Event Detail Modal -->
        <div class="modal" id="eventDetailModal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="detailEventTitleHead">Chi tiết Sự kiện</h2>
                    <button class="close-btn" onclick="closeModal('eventDetailModal')"><i
                            class="fas fa-times"></i></button>
                </div>
                <div class="event-profile-header"
                    style="padding: 20px; background: #f8fafc; border-radius: 12px; margin-bottom: 20px;">
                    <h3 id="detailEventName" style="font-size: 24px; color: #1e293b; margin-bottom: 10px;">Tên Sự kiện
                    </h3>
                    <div
                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 14px; color: #64748b;">
                        <p id="detailEventClub"><i class="fas fa-university"></i> Tổ chức: <span>Tên CLB</span></p>
                        <p id="detailEventLocation"><i class="fas fa-map-marker-alt"></i> Địa điểm: <span>Địa
                                điểm</span></p>
                        <p id="detailEventTime"><i class="fas fa-clock"></i> Thời gian: <span>Thời gian</span></p>
                        <p id="detailEventCreator"><i class="fas fa-user"></i> Người tạo: <span>Tên người tạo</span></p>
                    </div>
                    <div id="detailEventDesc"
                        style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #e2e8f0; font-size: 14px; color: #475569; line-height: 1.6;">
                        Mô tả sự kiện...
                    </div>
                </div>

                <div style="margin-top: 20px;">
                    <h4 style="margin-bottom: 10px; border-bottom: 2px solid #2563eb; display: inline-block;">Danh sách
                        đăng ký (<span id="detailRegCount">0</span>)</h4>
                    <div style="max-height: 300px; overflow-y: auto;">
                        <table class="table" id="eventRegTable">
                            <thead>
                                <tr>
                                    <th>Người dùng</th>
                                    <th>Email</th>
                                    <th>Ngày đăng ký</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Data populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-left: var(--sidebar-width);">
            <%- include('partials/Footer') %>
        </div>
        <!-- Core Admin Logic -->
        <!-- Award Points Modal -->
        <div class="modal" id="awardPointsModal">
            <div class="modal-content" style="max-width: 500px;">
                <div class="modal-header">
                    <h2>Cộng điểm rèn luyện</h2>
                    <button class="close-btn" onclick="closeModal('awardPointsModal')"><i
                            class="fas fa-times"></i></button>
                </div>
                <form id="awardPointsForm">
                    <div class="form-group">
                        <label>MSSV hoặc Email sinh viên</label>
                        <input type="text" id="awardPointsUser" placeholder="Gõ để tìm sinh viên..." required
                            list="studentList">
                        <datalist id="studentList"></datalist>
                    </div>
                    <div class="form-group">
                        <label>Số điểm cộng</label>
                        <input type="number" id="awardPointsValue" value="5" min="1" max="100" required>
                    </div>
                    <div class="form-group">
                        <label>Lý do cộng điểm</label>
                        <textarea id="awardPointsReason" placeholder="Ví dụ: Tham gia tích cực hoạt động tình nguyện..."
                            required></textarea>
                    </div>
                    <button type="submit" class="btn-submit-mod">
                        <i class="fas fa-star"></i> Xác nhận cộng điểm
                    </button>
                </form>
            </div>
        </div>

        <script src="/JS/admin.js?v=4"></script>
</body>

</html>