<%- include('partials/Header') %>
<div class="auth-container" style="display: flex; justify-content: center; max-width: 600px; grid-template-columns: 1fr; margin-top: 120px;">
    <div class="auth-card" style="width: 100%;">
        <div class="auth-header" style="padding-bottom: 20px;">
            <i class="fas fa-unlock-alt" style="font-size: 50px;"></i>
            <h2>Quên Mật Khẩu?</h2>
            <p>Nhập email của bạn để nhận liên kết đặt lại mật khẩu</p>
        </div>

        <div class="auth-form" style="padding-top: 10px;">
            <div class="form-group">
                <label>Email đã đăng ký</label>
                <div class="input-with-icon">
                    <i class="fas fa-envelope"></i>
                    <input type="email" placeholder="your.email@example.com" id="resetEmail">
                </div>
            </div>

            <button class="btn-auth" onclick="handleResetPassword()" style="margin-top: 10px;">
                <i class="fas fa-paper-plane"></i> Gửi Yêu Cầu
            </button>

            <div class="divider">
                <span>hoặc</span>
            </div>
            
            <div style="text-align: center;">
                <a href="/dangnhap" style="color: #e53e3e; font-weight: 600; text-decoration: none;"><i class="fas fa-arrow-left"></i> Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</div>

<%- include('partials/Footer') %>
<link rel="stylesheet" href="CSS/dangnhap.css">
<script src="JS/clb.js"></script>
<script>
    async function handleResetPassword() {
        const email = document.getElementById('resetEmail').value.trim();
        if (!email) {
            if (typeof showToast === 'function') {
                showToast('Vui lòng nhập địa chỉ email!', 'warning');
            } else {
                alert('Vui lòng nhập địa chỉ email!');
            }
            return;
        }

        const btn = document.querySelector('.btn-auth');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang gửi...';
        btn.disabled = true;

        try {
            const response = await fetch('/api/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });
            const data = await response.json();

            btn.innerHTML = originalText;
            btn.disabled = false;

            if (response.ok) {
                if (typeof showToast === 'function') {
                    showToast(data.message, 'success');
                } else {
                    alert(data.message);
                }
                document.getElementById('resetEmail').value = '';

                // Hiển thị link xem trước Email (Chỉ dùng cho môi trường Test/Dev)
                if (data.previewUrl) {
                    let linkContainer = document.getElementById('devPreviewLink');
                    if (!linkContainer) {
                        linkContainer = document.createElement('div');
                        linkContainer.id = 'devPreviewLink';
                        linkContainer.style.marginTop = '20px';
                        linkContainer.style.textAlign = 'center';
                        linkContainer.style.padding = '15px';
                        linkContainer.style.background = 'rgba(197, 48, 48, 0.05)';
                        linkContainer.style.borderRadius = '10px';
                        document.querySelector('.auth-form').appendChild(linkContainer);
                    }
                    linkContainer.innerHTML = `<a href="${data.previewUrl}" target="_blank" style="color: #c53030; text-decoration: underline; font-weight: bold;"><i class="fas fa-external-link-alt"></i> Mở xem Email khôi phục (Dev Mode)</a>`;
                }
            } else {
                if (typeof showToast === 'function') {
                    showToast(data.message, 'error');
                } else {
                    alert(data.message);
                }
            }
        } catch (error) {
            btn.innerHTML = originalText;
            btn.disabled = false;
            console.error(error);
            if (typeof showToast === 'function') {
                showToast('Lỗi kết nối đến máy chủ!', 'error');
            } else {
                alert('Lỗi kết nối đến máy chủ!');
            }
        }
    }
</script>
